# Copie para .env (que NUNCA vai para o git: o repositório é público).
API_URL=http://localhost:8000
# chave da Anthropic da PLATAFORMA (clientes de créditos). Chave própria de cliente vem da API, nunca daqui.
ANTHROPIC_API_KEY=
# token de serviço do agente: só para POST /uso. Mesmo valor e mesmo nome que a API lê. Dados de cliente vão sempre com o token do usuário.
TOKEN_SERVICO_AGENTE=
# opcional: troca o modelo (precisa ter preço em canteiro_agente/precos.py)
# AGENTE_MODELO=claude-opus-5-5
# 1 = demo sem chave: o agente fala com o modelo de roteiro embutido (0 tokens). 0 = Claude de verdade (ANTHROPIC_API_KEY)
MODELO_ROTEIRO=1
# opcional: teto de uma resposta inteira em segundos (abaixo dos 300 s da função da web) e intervalo do ping do SSE
# AGENTE_TEMPO_MAX_VOLTA=240
# AGENTE_INTERVALO_PING=15
